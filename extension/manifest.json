{
  "manifest_version": 3,
  "name": "gflowris bridge",
  "description": "Connect your Flow project to the local image queue. Your Google login stays in Chrome.",
  "version": "1.0.4",
  "permissions": [
    "storage",
    "downloads",
    "debugger",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://flow.google.com/*",
    "https://labs.google/fx/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "gflowris",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/*"
      ],
      "js": [
        "page-actions.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/*"
      ],
      "js": [
        "activation.js",
        "flow-adapter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
